@model CartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="cart-page">
    <div class="cart-hero mb-4">
        <p class="catalog-eyebrow mb-1">Your selections</p>
        <h1 class="catalog-title mb-2">Shopping Cart</h1>
        <p class="catalog-subtitle mb-0">
            @if (Model.IsEmpty)
            {
                <span>No items in your cart yet</span>
            }
            else
            {
                <span>@Model.TotalItems @(Model.TotalItems == 1 ? "item" : "items")</span>
            }
        </p>
    </div>

    @if (TempData["CartMessage"] is string message)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.IsEmpty)
    {
        <div class="card border-0 shadow-sm catalog-empty">
            <div class="card-body text-center py-5 px-4">
                <div class="catalog-empty-icon mb-3" aria-hidden="true">&#128722;</div>
                <h2 class="h5">Your cart is empty</h2>
                <p class="text-muted mb-4">Browse our products and add something you like.</p>
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Continue shopping</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm cart-items-card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table cart-table mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col">Product</th>
                                        <th scope="col" class="text-end">Price</th>
                                        <th scope="col" class="text-center">Qty</th>
                                        <th scope="col" class="text-end">Total</th>
                                        <th scope="col" class="text-end"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    @if (!string.IsNullOrEmpty(item.ImagePath))
                                                    {
                                                        <img src="~/@item.ImagePath" alt="@item.Name" class="cart-item-img" />
                                                    }
                                                    else
                                                    {
                                                        <div class="cart-item-img cart-item-img-placeholder">No image</div>
                                                    }
                                                    <span class="fw-semibold">@item.Name</span>
                                                </div>
                                            </td>
                                            <td class="text-end">@item.Price.ToString("C")</td>
                                            <td class="text-center">
                                                <form asp-action="Update" method="post" class="d-inline-flex align-items-center gap-2 cart-qty-form">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <input type="number"
                                                           name="quantity"
                                                           value="@item.Quantity"
                                                           min="1"
                                                           max="99"
                                                           class="form-control form-control-sm cart-qty-input"
                                                           aria-label="Quantity for @item.Name" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                                                </form>
                                            </td>
                                            <td class="text-end fw-semibold">@item.LineTotal.ToString("C")</td>
                                            <td class="text-end">
                                                <form asp-action="Remove" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="mt-3 d-flex flex-wrap gap-2">
                    <a class="btn btn-outline-dark" asp-controller="Home" asp-action="Index">Continue shopping</a>
                    <form asp-action="Clear" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger">Clear cart</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4">
                <aside class="card border-0 shadow-sm cart-summary-card sticky-lg-top">
                    <div class="card-header cart-summary-header">
                        <h2 class="h6 mb-0">Order summary</h2>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Items (@Model.TotalItems)</span>
                            <span>@Model.Subtotal.ToString("C")</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Subtotal</span>
                            <span class="text-primary">@Model.Subtotal.ToString("C")</span>
                        </div>
                        <p class="text-muted small mt-3 mb-4">Taxes and shipping calculated at checkout.</p>
                        <a class="btn btn-primary w-100" asp-controller="Checkout" asp-action="Index">Proceed to checkout</a>
                    </div>
                </aside>
            </div>
        </div>
    }
</div>
