@model OrderViewModel
@{
    ViewData["Title"] = "Order details";
}

<h2 class="mb-3">Order #@Model.Id</h2>

@if (TempData["SuccessMessage"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="h6 mb-0">Customer &amp; shipping</h3>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Customer</dt>
                    <dd class="col-sm-8">@Model.CustomerName</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.CustomerEmail</dd>

                    <dt class="col-sm-4">Shipping address</dt>
                    <dd class="col-sm-8">@Model.ShippingAddress</dd>

                    <dt class="col-sm-4">Order date</dt>
                    <dd class="col-sm-8">@Model.OrderDate.ToLocalTime().ToString("f")</dd>
                </dl>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="h6 mb-0">Order items</h3>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th class="text-end">Unit price</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Line total</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.LineTotal.ToString("C")</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Subtotal</th>
                                <th class="text-end">@Model.Subtotal.ToString("C")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">
                <h3 class="h6 mb-0">Order status</h3>
            </div>
            <div class="card-body">
                <p class="mb-3">
                    Current status:
                    <span class="badge order-status-badge order-status-@Model.Status.ToString().ToLowerInvariant()">
                        @Model.StatusDisplayName
                    </span>
                </p>

                <form asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Id" />

                    <div class="mb-3">
                        <label for="Status" class="form-label">Update status</label>
                        <select name="Status" id="Status" class="form-select">
                            @foreach (var item in Html.GetEnumSelectList<OrderStatus>())
                            {
                                <option value="@item.Value" selected="@(item.Value == ((int)Model.Status).ToString())">@item.Text</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary">Save status</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-secondary" asp-action="Index">Back to orders</a>
</div>
